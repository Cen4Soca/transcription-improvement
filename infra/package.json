{
  "name": "transcription-review-infra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "test": "vitest --run",
    "test:watch": "vitest",
    "deploy": "cdk deploy --all --require-approval never",
    "deploy:foundation": "cdk deploy *-FoundationStack",
    "diff": "cdk diff --all",
    "synth": "cdk synth --all"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "aws-cdk": "^2.150.0",
    "esbuild": "^0.28.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
