{
  "name": "transcription-review-infra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "test": "vitest --run",
    "test:watch": "vitest",
    "deploy": "cdk deploy --all --require-approval never",
    "deploy:foundation": "cdk deploy *-FoundationStack",
    "backfill:review-assignments": "ts-node scripts/backfill-review-assignments.ts",
    "diff": "cdk diff --all",
    "synth": "cdk synth --all"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "aws-cdk-lib": "^2.277.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "aws-cdk": "^2.1149.0",
    "esbuild": "^0.28.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
