# Frontend environment variables (Vite)
# Copy this file to `.env` and fill in your own values.
# Do NOT commit `.env` or `.env.production` — they contain real AWS resource IDs.

# Base path for the SPA (leave empty for root deployment)
VITE_BASE_PATH=

# Cognito User Pool ID (e.g. ap-northeast-1_xxxxxxxxx)
VITE_USER_POOL_ID=

# Cognito User Pool App Client ID
VITE_USER_POOL_CLIENT_ID=

# API Gateway HTTP API endpoint (e.g. https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com)
VITE_API_ENDPOINT=

# Cognito hosted UI domain (optional)
VITE_COGNITO_DOMAIN=
